{
  "name": "@simpod/opencode-plugin-sessions",
  "version": "0.1.0",
  "description": "OpenCode V2 session tools for private transcript archives and restoration.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26.4"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "scripts",
    "patches",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-sdk-types.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@opencode/schema": "2.0.24",
    "effect": "4.0.0-rc.112",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.24 <3"
  },
  "devDependencies": {
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "@opencode/theme": "^2.0.24",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.19.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  }
}
